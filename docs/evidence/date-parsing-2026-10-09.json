  "native_semantics": [
    "strict en_US SimpleDateFormat; a valid prefix is accepted",
    "MMM and MMMM accept short and full names in any case",
    "yy with exactly two digits resolves within 80 years before and 20 years after now; other digit counts are literal years",
    "12 AM is midnight; h accepts 1-12 and K 0-11; k 24 is midnight",
    "a contradicting weekday, Feb 30, hour 25, year 0, an unknown name and a double blank before a name reject the text",
    "missing fields default to 1970-01-01; a weekday alone resolves to its first occurrence in January 1970",
    "w resolves to the Sunday of the US week",
    "parseDateTime reads the session time zone, UTC in system context; z accepts UTC, GMT, EST and UTC's long name"
  ],
  "deliberate_divergence": "Mendix (Java GregorianCalendar) uses the Julian calendar before 1582-10-15; MXRB raises an error for those dates instead of returning a shifted instant",
  "limitations": [
    "TypeScript nanoflows keep the numeric parseDateTimeUTC subset",
    "zone names other than UTC, GMT and EST are rejected",
    "nonexistent or repeated local times around DST changes are not certified"
  ]
