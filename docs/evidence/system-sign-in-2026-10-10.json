  "ruby": {
    "session_manager_identical": true,
    "note": "the Ruby spec replays the steps with a simulated clock for the five-minute block"
  },
  "native_semantics": [
    "the user name ignores case",
    "blocked, inactive and web service users and users without roles get 401 before the password is checked; their counters do not change",
    "a wrong or empty password adds one FailedLogins; the third sets Blocked and BlockedSince, and later attempts are refused without counting",
    "after five minutes a failed-login block expires: the next correct password signs in and clears Blocked, BlockedSince and FailedLogins",
    "a block without BlockedSince (set directly) stays",
    "success resets FailedLogins and sets LastLogin",
    "NanoflowCommons.SignIn returns 401 without a request when the name or password is empty"
  ],
  "limitations": [
    "the exact boundary of the five-minute block (>= vs >) was not measured",
    "NanoflowCommons.SignIn useAuthToken is ignored; the Ruby app uses its session cookie"
  ]
}
