{
  "name": "@mxrb/modeler-ui",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "node build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test:studio": "node --test --test-isolation=none test/studio/*.test.mjs",
    "build": "npm run typecheck && node build.ts",
    "build:studio": "npm run typecheck && node build.ts --studio",
    "test:build": "node --test test/build/*.test.mjs"
  },
  "dependencies": {
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    }
  }
}
