{
  "name": "@mxrb/modeler-ui",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:studio": "node --test --test-isolation=none test/studio/*.test.mjs",
    "build": "npm run typecheck && vite build && vite build --config vite.studio.config.ts",
    "build:studio": "npm run typecheck && vite build --config vite.studio.config.ts"
  },
  "dependencies": {
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    }
  }
}
