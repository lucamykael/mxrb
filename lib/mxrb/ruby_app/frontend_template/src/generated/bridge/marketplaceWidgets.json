{
  "description": "Pluggable widget ids the generated frontend renders (matched against the lowercased id). Shared by marketplace.tsx and Mxrb::RubyApp::PortabilityReport; any other id renders as a visible unsupported placeholder.",
  "widgets": [
    {
      "pattern": "\\.image$",
      "support": "full",
      "examples": ["com.mendix.widget.web.image.Image"]
    },
    {
      "pattern": "customchart",
      "support": "full",
      "examples": ["com.mendix.widget.web.customchart.CustomChart"]
    },
    {
      "pattern": "(progressbar|progresscircle|rangeslider|slider|rating|colorpicker|togglebuttons)\\.",
      "support": "full",
      "examples": [
        "com.mendix.widget.custom.progressbar.ProgressBar",
        "com.mendix.widget.custom.progresscircle.ProgressCircle",
        "com.mendix.widget.custom.slider.Slider",
        "com.mendix.widget.custom.rangeslider.RangeSlider",
        "com.mendix.widget.custom.starrating.StarRating",
        "com.mendix.widget.web.colorpicker.ColorPicker"
      ]
    },
    {
      "pattern": "(area|bar|bubble|column|custom|heatmap|line|pie|time)chart|timeseries|heatmap",
      "support": "full",
      "examples": [
        "com.mendix.widget.web.linechart.LineChart",
        "com.mendix.widget.web.timeseries.TimeSeries"
      ]
    },
    {
      "pattern": "switch",
      "support": "full",
      "examples": ["com.mendix.widget.custom.switch.Switch"]
    },
    {
      "pattern": "badgebutton",
      "support": "full",
      "examples": ["com.mendix.widget.custom.badgebutton.BadgeButton"]
    },
    {
      "pattern": "badge",
      "support": "full",
      "examples": ["com.mendix.widget.custom.badge.Badge"]
    },
    {
      "pattern": "accordion",
      "support": "full",
      "examples": ["com.mendix.widget.web.accordion.Accordion"]
    },
    {
      "pattern": "fieldset",
      "support": "full",
      "examples": ["com.mendix.widget.web.fieldset.Fieldset"]
    },
    {
      "pattern": "accessibilityhelper",
      "support": "full",
      "examples": ["com.mendix.widget.web.accessibilityhelper.AccessibilityHelper"]
    },
    {
      "pattern": "htmlelement",
      "support": "full",
      "examples": ["com.mendix.widget.web.htmlelement.HTMLElement"]
    },
    {
      "pattern": "languageselector",
      "support": "full",
      "examples": ["com.mendix.widget.web.languageselector.LanguageSelector"]
    },
    {
      "pattern": "popupmenu",
      "support": "full",
      "examples": ["com.mendix.widget.web.popupmenu.PopupMenu"]
    },
    {
      "pattern": "timeline",
      "support": "full",
      "examples": ["com.mendix.widget.web.timeline.Timeline"]
    },
    {
      "pattern": "tooltip",
      "support": "full",
      "examples": ["com.mendix.widget.web.tooltip.Tooltip"]
    },
    {
      "pattern": "carousel",
      "support": "full",
      "examples": ["com.mendix.widget.web.carousel.Carousel"]
    },
    {
      "pattern": "safearea",
      "support": "full",
      "examples": ["com.mendix.widget.native.safeareaview.SafeAreaView"]
    },
    {
      "pattern": "treenode|treeview",
      "support": "full",
      "examples": ["com.mendix.widget.web.treenode.TreeNode"]
    },
    {
      "pattern": "videoplayer",
      "support": "full",
      "examples": ["com.mendix.widget.web.videoplayer.VideoPlayer"]
    },
    {
      "pattern": "barcodescanner",
      "support": "approximate",
      "note": "no camera access; renders a button",
      "examples": ["com.mendix.widget.web.barcodescanner.BarcodeScanner"]
    },
    {
      "pattern": "^htmlsnippet\\.widget\\.htmlsnippet",
      "support": "full",
      "examples": ["HTMLSnippet.widget.HTMLSnippet", "HTMLSnippet.widget.HTMLSnippetContext"]
    },
    {
      "pattern": "^microflowtimer\\.widget\\.microflowtimer$",
      "support": "full",
      "examples": ["MicroflowTimer.widget.MicroflowTimer"]
    },
    {
      "pattern": "csvastable$",
      "support": "full",
      "examples": ["CSVasTable.widget.CSVasTable", "mendix.csvastable.CSVasTable"]
    },
    {
      "pattern": "iframecomponent$",
      "support": "full",
      "examples": ["mendix.iframecomponent.IFrameComponent"]
    },
    {
      "pattern": "^com\\.mendix\\.widget\\.web\\.events\\.events$",
      "support": "full",
      "examples": ["com.mendix.widget.web.events.Events"]
    },
    {
      "pattern": "tabpageselector$",
      "support": "full",
      "examples": ["mendix.tabpageselector.TabPageSelector"]
    },
    {
      "pattern": "dynamicenumpicker$",
      "support": "full",
      "examples": ["itvisors.dynamicenumpicker.DynamicEnumPicker"]
    },
    {
      "pattern": "advancedpagination$",
      "support": "full",
      "examples": ["mendix.advancedpagination.AdvancedPagination"]
    },
    {
      "pattern": "^json\\.widget\\.editor$",
      "support": "full",
      "examples": ["JSON.widget.Editor"]
    }
  ]
}
