  "partial": "Some operations implemented; others listed as gaps",
  "missing": "No MXRB implementation",
  "not_applicable": "Dimension does not apply",
  "not_assessed": "Not yet inventoried or evidenced",
  "accepted_integrated_studio": "Exercised in the integrated IDE",
  "accepted_harness": "Exercised in an isolated panel harness only",
  "implemented_unaccepted": "IDE surface implemented, not yet accepted in the integrated IDE",
  "original_backend": "IDE surface uses the original Studio Pro logic",
  "task_catalog": "Reachable as a typed task in MXRB Tasks",
  "validated_scope": "Behaviour validated for the stated scope",
  "not_validated": "Behaviour not validated",
  "yes": "Works without Studio Pro logic",
  "no": "Depends on Studio Pro logic or has no Ruby implementation",
  "present": "Capability exists in Studio Pro"
 },
