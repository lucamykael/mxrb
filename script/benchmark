#!/usr/bin/env ruby
# frozen_string_literal: true

require "benchmark"
require "fileutils"
require "json"
require "tmpdir"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require_relative "../lib/mxrb"

fixture_value = ENV.fetch("MXRB_BENCHMARK_MPR", "").strip
abort "MXRB_BENCHMARK_MPR must point to an external benchmark MPR" if fixture_value.empty?

fixture = File.expand_path(fixture_value)
raise "#{fixture}: benchmark fixture not found" unless File.file?(fixture)

measurements = {}
measure = lambda do |name, &block|
  result = nil
  elapsed = Benchmark.realtime { result = block.call }
  measurements[name] = elapsed.round(4)
  result
end

measure.call(:validate) { Mxrb.validate(fixture) }
cache_metrics = {}
Dir.mktmpdir("mxrb-cache-benchmark-") do |directory|
  cached_fixture = File.join(directory, File.basename(fixture))
  FileUtils.cp(fixture, cached_fixture)
  Mxrb.open(cached_fixture, readonly: false, &:clear_semantic_cache!)

  measure.call(:semantic_index_cold) do
    Mxrb.open(cached_fixture, readonly: false) do |project|
      project.semantic_index.artifacts.size + project.semantic_index.references.size
    end
  end
  measure.call(:semantic_index_warm) do
    Mxrb.open(cached_fixture, readonly: false) do |project|
      project.semantic_index.artifacts.size + project.semantic_index.references.size
    end
  end
  cache_metrics = Mxrb.open(cached_fixture, &:semantic_cache_info)
  cold = measurements.fetch(:semantic_index_cold)
  warm = measurements.fetch(:semantic_index_warm)
  cache_metrics = cache_metrics.merge(
    speedup: warm.zero? ? nil : (cold / warm).round(2)
  )
  Mxrb.open(cached_fixture, readonly: false, &:clear_semantic_cache!)
  cache_metrics[:cleared] = !Mxrb.open(cached_fixture, &:semantic_cache_info).fetch(:present)
end

measure.call(:semantic_index_readonly) do
  Mxrb.open(fixture) do |project|
    project.semantic_index.artifacts.size + project.semantic_index.references.size
  end
end

Dir.mktmpdir("mxrb-benchmark-") do |directory|
  exported = File.join(directory, "ruby")
  rebuilt = File.join(directory, File.basename(fixture))
  measure.call(:export) { Mxrb::Exporter.new(fixture, exported).export! }
  measure.call(:generate) do
    begin
      ENV["MXRB_OUTPUT_PATH"] = rebuilt
      load File.join(exported, "project.rb")
    ensure
      ENV.delete("MXRB_OUTPUT_PATH")
    end
  end
  result = measure.call(:compare) { Mxrb.compare(fixture, rebuilt) }
  raise result.differences.first unless result.identical?
end

payload = {
  fixture:,
  ruby: RUBY_DESCRIPTION,
  semantic_cache: cache_metrics,
  measurements_seconds: measurements,
  total_seconds: measurements.values.sum.round(4)
}
puts JSON.pretty_generate(payload)
