#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'optparse'
require 'tmpdir'
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'mxrb'
require_relative 'package_copy'

options = { repair_hashes: false }
OptionParser.new do |parser|
  parser.banner = 'Usage: script/validate_ruby_app [--repair-hashes] FILE.mpr'
  parser.on('--repair-hashes', 'Repair stale hashes in a temporary copy before validation') do
    options[:repair_hashes] = true
  end
end.parse!
source = File.expand_path(ARGV.fetch(0))
abort "fixture not found: #{source}" unless File.file?(source)

# rubocop:disable Metrics/BlockLength
Dir.mktmpdir('mxrb-ruby-app-gate-') do |directory|
  working_source = source
  repairs = []
  owner = PackageCopy.contents_owner(source)
  shared_with = owner unless owner.nil? || Mxrb.validate(source).valid?
  if shared_with
    working_source = PackageCopy.claim(source, directory)
    warn "[mxrb] #{File.basename(source)}: validating a temporary copy, because mprcontents belongs to #{shared_with}"
  end
  if options[:repair_hashes] && !Mxrb.validate(working_source).valid?
    working_source = PackageCopy.copy(source, directory) if working_source == source
    mpr = Mxrb::IO::MprFile.open(working_source, readonly: false)
    repairs = mpr.repair_content_hashes!
    mpr.close
    validation = Mxrb.validate(working_source)
    abort validation.errors.join("\n") unless validation.valid?
  end

  exported = File.join(directory, 'ruby')
  rebuilt = File.join(directory, File.basename(source))
  rebuilt = File.join(directory, 'rebuilt', File.basename(source)) if rebuilt == working_source
  Mxrb::Exporter.new(working_source, exported, mode: :ruby).export!

  audit = Mxrb::PublicSourceAudit.new(exported)
  audit_failure = JSON.pretty_generate(summary: audit.summary, violations: audit.violations.map(&:to_h))
  abort audit_failure unless audit.clean?

  FileUtils.mv(File.join(exported, '.mxrb', 'mendix'), File.join(exported, '.mxrb', 'mendix.detached'))
  Mxrb::RubyApp.compile(exported, rebuilt)
  validation = Mxrb.validate(rebuilt)
  comparison = Mxrb.compare(working_source, rebuilt)
  abort validation.errors.join("\n") unless validation.valid?
  abort comparison.differences.join("\n") unless comparison.identical?

  puts JSON.generate({
    source:, contents_shared_with: shared_with, repaired_hashes: repairs.map { _1.fetch(:unit_id) },
    public_source: audit.summary, valid: validation.valid?, identical: comparison.identical?
  }.compact)
end
# rubocop:enable Metrics/BlockLength
