{
  "name": "marketplace-custom-plotly",
  "authentication": false,
  "viewport": { "width": 1280, "height": 900 },
  "pages": [
    {
      "name": "custom-options",
      "path": "/",
      "steps": [
        { "wait_for_selector": ".js-plotly-plot .barlayer path" },
        { "wait_for_text": "Dynamic title" },
