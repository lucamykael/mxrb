        { "click_selector": { "selector": ".mxrb-marketplace-chart summary" } },
        { "wait_for_text": "Dynamic" },
        { "click_text": "Change traces" },
        { "wait_for_idle": true },
        { "wait_for_text": "Changed" },
        {
          "click_selector": {
            "selector": ".js-plotly-plot .barlayer path",
            "index": 0
          }
        },
        { "wait_for_idle": true }
      ]
    }
  ]
}
