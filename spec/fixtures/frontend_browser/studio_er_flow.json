{
  "name": "mxrb-studio-global-er",
  "authentication": false,
  "viewport": { "width": 960, "height": 720 },
  "pages": [{
    "name": "studio-global-er",
    "path": "/studio.html",
    "steps": [
      { "click_text": "MXRB Global ER" },
      { "wait_for_selector": ".er-panel [data-entity='Sudoku.Game']" },
      { "wait_for_text": "Logical model · physical schema not confirmed" },
      { "wait_for_selector": ".er-frame-external" },
      { "wait_for_selector": ".er-panel [data-entity='System.User'].er-external" },
      { "wait_for_selector": ".er-panel [data-entity='Atlas_Web_Content.LoginContext'].er-non_persistent" },
      { "wait_for_selector": ".er-edge-inheritance" },
      { "wait_for_absence": ".er-panel [data-entity*='$']" },
      { "click_selector": ".er-panel [data-entity='Sudoku.Game']" },
      { "wait_for_selector": ".er-details[aria-label='Details of Sudoku.Game']" },
      { "wait_for_text": "Not confirmed (logical model only)" },
      { "click_selector": ".er-panel button[aria-label='Show only the selected entity\\'s neighbourhood']" },
      { "wait_for_absence": ".er-panel [data-entity='Administration.Account']" },
      { "wait_for_selector": ".er-panel [data-entity='Sudoku.Cell']" },
      { "click_selector": ".er-panel button[aria-label='Show only the selected entity\\'s neighbourhood']" },
      { "wait_for_selector": ".er-panel [data-entity='Administration.Account']" },
      { "click_selector": { "selector": ".er-details .er-link", "index": 0 } },
      { "wait_for_selector": ".er-details[aria-label='Details of Sudoku.Cell']" },
      { "input_value": { "selector": ".er-search", "value": "PuzzleNo" } },
      { "wait_for_text": "1 matching" },
      { "wait_for_count": { "selector": ".er-panel .er-entity:not(.er-dim)", "equals": 1 } },
      { "input_value": { "selector": ".er-search", "value": "" } },
      { "select_option": { "selector": ".er-panel select[aria-label='Relationships']", "option_index": 3 } },
      { "wait_for_count": { "selector": ".er-panel .er-edge", "equals": 1 } },
      { "select_option": { "selector": ".er-panel select[aria-label='Relationships']", "option_index": 0 } },
      { "click_selector": ".er-panel button[aria-label='Filter modules']" },
      { "click_text": "None" },
      { "wait_for_text": "No entities in the selected modules." },
      { "click_text": "All" },
      { "click_text": "Close" },
      { "wait_for_selector": ".er-panel [data-entity='Sudoku.Move']" },
      { "click_selector": ".er-panel button[aria-label='Zoom in']" },
      { "click_selector": ".er-panel button[aria-label='Fit to window']" },
      { "wait_for_absence": "[role='alert']" }
    ],
    "selectors": [ ".er-panel .mx-toolbar", ".er-canvas", ".er-details", ".mx-status-bar" ]
  }]
}
