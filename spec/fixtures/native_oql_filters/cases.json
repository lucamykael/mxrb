[
  {"name":"Exact", "where":"l.Amount = 9007199254740993.125", "expected":["North"]},
  {"name":"Different", "where":"l.Amount != 2.5", "expected":["Empty","Negative","North","Zero"]},
  {"name":"Less", "where":"l.Amount < 2.5", "expected":["Negative","Zero"]},
  {"name":"LessEqual", "where":"l.Amount <= 2.5", "expected":["Negative","South","Zero"]},
  {"name":"Greater", "where":"l.Amount > 2.5", "expected":["North"]},
  {"name":"GreaterEqual", "where":"l.Amount >= 2.5", "expected":["North","South"]},
  {"name":"NegativeValue", "where":"l.Amount = -1.25", "expected":["Negative"]},
  {"name":"Conjunction", "where":"l.Active = TRUE AND l.Amount > 0", "expected":["North"]},
  {"name":"Precedence", "where":"l.Name = 'South' OR l.Active = TRUE AND l.Amount > 0", "expected":["North","South"]},
  {"name":"Grouped", "where":"(l.Name = 'South' OR l.Active = TRUE) AND NOT (l.Amount > 3)", "expected":["South"]},
  {"name":"BooleanValue", "where":"NOT l.Active", "expected":["Negative","South","Zero"]},
  {"name":"IsNull", "where":"l.Amount IS NULL", "expected":["Empty"]},
  {"name":"IsNotNull", "where":"l.Amount IS NOT NULL", "expected":["Negative","North","South","Zero"]},
  {"name":"EqualNull", "where":"l.Amount = NULL", "expected":["Empty"]},
  {"name":"UnequalNull", "where":"l.Amount != NULL", "expected":["Negative","North","South","Zero"]},
  {"name":"ColumnsEqual", "where":"l.Amount = l.Other", "expected":["North"]},
  {"name":"ColumnsUnequal", "where":"l.Amount != l.Other", "expected":["Negative","South"]},
  {"name":"NotColumnsEqual", "where":"NOT (l.Amount = l.Other)", "expected":["Negative","South"]},
  {"name":"QuotedKeywords", "where":"l.Nick = 'SELECT WHERE FROM'", "expected":["North"]},
  {"name":"EscapedQuote", "where":"l.Nick = 'O''Brien'", "expected":["South"]},
  {"name":"UnknownOrTrue", "where":"l.Amount > 0 OR l.Name = 'Empty'", "expected":["Empty","North","South"]},
  {"name":"UnknownAndFalse", "where":"NOT (l.Amount > 0 AND l.Name = 'South')", "expected":["Empty","Negative","North","Zero"]},
  {"name":"NotLiteralEqual", "where":"NOT (l.Amount = 2.5)", "expected":["Empty","Negative","North","Zero"]},
  {"name":"ReversedLiteral", "where":"2.5 != l.Amount", "expected":["Empty","Negative","North","Zero"]},
  {"name":"ReversedNull", "where":"NULL = l.Amount", "expected":["Empty"]},
  {"name":"SlashPath", "where":"l/Amount = +2.5", "expected":["South"]},
  {"name":"StringEmpty", "where":"l.Nick = ''", "expected":["Negative","Zero"]},
  {"name":"StringNull", "where":"l.Nick IS NULL", "expected":["Empty"]},
  {"name":"StringUnequal", "where":"l.Nick != 'O''Brien'", "expected":["Empty","Negative","North","Zero"]},
  {"name":"NotStringEqual", "where":"NOT (l.Nick = 'O''Brien')", "expected":["Empty","Negative","North","Zero"]}
]
